{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "broadcast-overlay"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "league": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "name",
        "slug"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "in_progress",
            "provisional",
            "confirmed",
            "cancelled"
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptNumber": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "status",
        "attemptId",
        "attemptNumber"
      ],
      "additionalProperties": false
    },
    "inning": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "half": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "top",
            "bottom"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "teams": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "teamId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "side": {
              "type": "string",
              "enum": [
                "home",
                "away"
              ]
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "teamId",
            "name",
            "side",
            "runs",
            "hits",
            "errors"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "teamId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "side": {
              "type": "string",
              "enum": [
                "home",
                "away"
              ]
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "teamId",
            "name",
            "side",
            "runs",
            "hits",
            "errors"
          ],
          "additionalProperties": false
        }
      ]
    },
    "players": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 127
          },
          "teamId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "homeRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runsBattedIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "strikeouts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "characterId",
          "teamId",
          "hits",
          "homeRuns",
          "runsBattedIn",
          "runs",
          "strikeouts"
        ],
        "additionalProperties": false
      }
    },
    "recentEvents": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eventType": {
            "type": "string",
            "enum": [
              "synthetic",
              "game-started",
              "inning-started",
              "batter-changed",
              "pitcher-changed",
              "plate-appearance-ended",
              "substitution",
              "game-ended",
              "bridge-warning"
            ]
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "payload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "sequence",
          "frame",
          "eventType",
          "receivedAt",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "updatedAt",
    "league",
    "match",
    "inning",
    "half",
    "teams",
    "players",
    "recentEvents"
  ],
  "additionalProperties": false,
  "$id": "https://starworks.community/contracts/broadcast-overlay/v1.schema.json"
}
