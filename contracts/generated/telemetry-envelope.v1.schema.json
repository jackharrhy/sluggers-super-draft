{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "telemetry-envelope"
    },
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "leagueId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "matchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attemptNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "type": "string",
      "enum": [
        "synthetic",
        "game-started",
        "inning-started",
        "plate-appearance-ended",
        "substitution",
        "game-ended",
        "bridge-warning"
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "gameBuildSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "protocolVersion",
    "correlationId",
    "leagueId",
    "matchId",
    "attemptId",
    "attemptNonce",
    "sequence",
    "frame",
    "eventType",
    "payload",
    "adapterVersion",
    "gameBuildSha256"
  ],
  "additionalProperties": false,
  "title": "TelemetryEnvelope v1",
  "description": "One ordered, idempotently ingestible game event.",
  "$id": "https://starworks.community/contracts/telemetry-envelope/v1.schema.json"
}
