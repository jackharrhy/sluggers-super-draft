{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "content-pack-manifest"
    },
    "contentPackId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetGame": {
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "const": "RMBE01"
        },
        "supportedRevisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "const": "NTSC-U"
              },
              "revision": {
                "type": "number",
                "const": 0
              },
              "mainDolSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "region",
              "revision",
              "mainDolSha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "gameId",
        "supportedRevisions"
      ],
      "additionalProperties": false
    },
    "statProfileRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "rulesetRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 127
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "sha256",
          "mediaType",
          "sizeBytes"
        ],
        "additionalProperties": false
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "assignmentType": {
                "type": "string",
                "const": "character-stats"
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              },
              "statProfileRevisionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "assignmentType",
              "characterId",
              "statProfileRevisionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "assignmentType": {
                "type": "string",
                "const": "character-asset"
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              },
              "slot": {
                "type": "string",
                "enum": [
                  "icon",
                  "portrait",
                  "model",
                  "texture"
                ]
              },
              "assetSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "assignmentType",
              "characterId",
              "slot",
              "assetSha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "kind",
    "contentPackId",
    "revisionId",
    "targetGame",
    "statProfileRevisionId",
    "rulesetRevisionId",
    "adapterVersion",
    "assets",
    "assignments",
    "createdAt"
  ],
  "additionalProperties": false,
  "title": "ContentPackManifest v1",
  "description": "Distributable, declarative inputs for a local Sluggers game build.",
  "$id": "https://starworks.community/contracts/content-pack-manifest.schema.json"
}
