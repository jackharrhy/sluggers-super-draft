{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "adapter-operation-bundle"
    },
    "adapterId": {
      "type": "string",
      "const": "sluggers-rmbe01"
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "leagueId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "statProfileRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "rulesetRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "rosterRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "lineupRevisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "matchLineupOverrideId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operations": {
      "maxItems": 8192,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "apply-sluggers-stat-profile"
              },
              "loadPhase": {
                "type": "string",
                "const": "build-time"
              },
              "resource": {
                "type": "string",
                "const": "main-dol"
              },
              "characterValues": {
                "minItems": 101,
                "maxItems": 101,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "characterId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 127
                    },
                    "values": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "maxLength": 80,
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "characterId",
                    "values"
                  ],
                  "additionalProperties": false
                }
              },
              "tuning": {
                "type": "object",
                "properties": {
                  "characterIdsByIndex": {
                    "minItems": 101,
                    "maxItems": 101,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 127
                    }
                  },
                  "chemistry": {
                    "minItems": 101,
                    "maxItems": 101,
                    "type": "array",
                    "items": {
                      "minItems": 101,
                      "maxItems": 101,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "trajectoryTables": {
                    "minItems": 24,
                    "maxItems": 24,
                    "type": "array",
                    "items": {
                      "minItems": 25,
                      "maxItems": 25,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "trajectoryNames": {
                    "minItems": 6,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "trajectoryActivation": {
                    "minItems": 6,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "globalSpeedCurves": {
                    "minItems": 43,
                    "maxItems": 43,
                    "type": "array",
                    "items": {
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "teamStarEvents": {
                    "minItems": 12,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "minItems": 41,
                      "maxItems": 41,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "starBoosts": {
                    "minItems": 16,
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "minItems": 4,
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "starHandicaps": {
                    "minItems": 4,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "handicapParameters": {
                    "minItems": 2,
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "minItems": 3,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    }
                  },
                  "importSource": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "type": "string",
                        "const": "stat-editor-v4"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "format",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "characterIdsByIndex",
                  "chemistry",
                  "trajectoryTables",
                  "trajectoryNames",
                  "trajectoryActivation",
                  "globalSpeedCurves",
                  "teamStarEvents",
                  "starBoosts",
                  "starHandicaps",
                  "handicapParameters",
                  "importSource"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "loadPhase",
              "resource",
              "characterValues",
              "tuning"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "set-character-stat"
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              },
              "statKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "gameplayTarget": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,126}$"
              },
              "loadPhase": {
                "type": "string",
                "enum": [
                  "build-time",
                  "runtime"
                ]
              },
              "resource": {
                "type": "string",
                "enum": [
                  "dt-na-dat",
                  "main-dol",
                  "runtime-bridge"
                ]
              },
              "codec": {
                "type": "string",
                "enum": [
                  "bool",
                  "enum",
                  "f32-be",
                  "s16-be",
                  "u16-be",
                  "u32-be",
                  "u8"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "operation",
              "characterId",
              "statKey",
              "gameplayTarget",
              "loadPhase",
              "resource",
              "codec",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "set-game-rule"
              },
              "ruleKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "loadPhase": {
                "type": "string",
                "enum": [
                  "build-time",
                  "runtime"
                ]
              },
              "gameplayTarget": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,126}$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "operation",
              "ruleKey",
              "loadPhase",
              "gameplayTarget",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "select-roster-slot"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              }
            },
            "required": [
              "operation",
              "slot",
              "characterId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "set-captain"
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              }
            },
            "required": [
              "operation",
              "characterId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "set-batting-slot"
              },
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              }
            },
            "required": [
              "operation",
              "slot",
              "characterId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "set-fielding-position"
              },
              "position": {
                "type": "string",
                "enum": [
                  "P",
                  "C",
                  "1B",
                  "2B",
                  "3B",
                  "SS",
                  "LF",
                  "CF",
                  "RF"
                ]
              },
              "characterId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              }
            },
            "required": [
              "operation",
              "position",
              "characterId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "adapterId",
    "adapterVersion",
    "leagueId",
    "statProfileRevisionId",
    "rulesetRevisionId",
    "rosterRevisionId",
    "lineupRevisionId",
    "matchLineupOverrideId",
    "operations",
    "generatedAt"
  ],
  "additionalProperties": false,
  "title": "AdapterOperationBundle",
  "description": "Symbolic, bounded operations translated by the current game adapter; never raw memory writes.",
  "$id": "https://starworks.community/contracts/adapter-operation-bundle/v1.schema.json"
}
