{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "telemetry-upload-request"
        },
        "runnerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "leaseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "events": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "kind": {
                "type": "string",
                "const": "telemetry-envelope"
              },
              "protocolVersion": {
                "type": "number",
                "const": 1
              },
              "correlationId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "leagueId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "matchId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "attemptId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "attemptNonce": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{32,128}$"
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eventType": {
                "type": "string",
                "enum": [
                  "synthetic",
                  "game-started",
                  "inning-started",
                  "batter-changed",
                  "pitcher-changed",
                  "plate-appearance-ended",
                  "substitution",
                  "game-ended",
                  "bridge-warning"
                ]
              },
              "observationSource": {
                "type": "string",
                "enum": [
                  "bridge-hook",
                  "memory-observation",
                  "synthetic"
                ]
              },
              "payload": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {}
              },
              "adapterVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
              },
              "gameBuildSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "stateFingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "schemaVersion",
              "kind",
              "protocolVersion",
              "correlationId",
              "leagueId",
              "matchId",
              "attemptId",
              "attemptNonce",
              "sequence",
              "frame",
              "eventType",
              "observationSource",
              "payload",
              "adapterVersion",
              "gameBuildSha256"
            ],
            "additionalProperties": false,
            "title": "TelemetryEnvelope v1",
            "description": "One ordered, idempotently ingestible game event."
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "runnerId",
        "attemptId",
        "leaseId",
        "events"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "telemetry-upload-response"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "acceptedSequences": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "duplicateSequences": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "nextExpectedSequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAcceptedSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiresReview": {
          "type": "boolean"
        },
        "issues": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "attemptId",
        "acceptedSequences",
        "duplicateSequences",
        "nextExpectedSequence",
        "maxAcceptedSequence",
        "requiresReview",
        "issues"
      ],
      "additionalProperties": false
    }
  ],
  "title": "TelemetryUploadMessage v1",
  "description": "Bounded, retry-safe upload of locally spooled telemetry events.",
  "$id": "https://starworks.community/contracts/telemetry-upload/v1.schema.json"
}
