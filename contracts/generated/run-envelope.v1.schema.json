    "kind",
    "correlationId",
    "createdByActorId",
    "leagueId",
    "seasonId",
    "matchId",
    "attemptId",
    "attemptNonce",
    "requiredGameBuildSha256",
    "teams",
    "dynamicRuleOverrides",
    "lease",
    "issuedAt"
