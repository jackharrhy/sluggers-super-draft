            },
            {
              "type": "null"
            }
          ]
        },
        "activeLeaseId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCapturedSequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "type": "object",
          "properties": {
            "dolphin": {
              "type": "string",
              "enum": [
                "disabled",
                "starting",
                "healthy",
                "degraded",
                "failed",
                "stopped"
              ]
            },
            "bridge": {
              "type": "string",
              "enum": [
                "disabled",
                "starting",
                "healthy",
                "degraded",
                "failed",
                "stopped"
              ]
            },
            "recording": {
              "type": "string",
              "enum": [
                "disabled",
                "starting",
                "healthy",
                "degraded",
                "failed",
                "stopped"
              ]
            },
            "publishing": {
              "type": "string",
              "enum": [
                "disabled",
                "starting",
                "healthy",
                "degraded",
                "failed",
                "stopped"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "runnerId",
        "sentAt",
        "state",
        "activeAttemptId",
        "activeLeaseId",
        "lastCapturedSequence"
      ],
      "additionalProperties": false
    },
