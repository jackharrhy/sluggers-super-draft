{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "runner-registration-request"
        },
        "stationName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "architecture": {
              "type": "string",
              "enum": [
                "arm64",
                "x64"
              ]
            },
            "operatingSystem": {
              "type": "string",
              "enum": [
                "linux",
                "macos",
                "windows"
              ]
            },
            "runnerVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            },
            "adapterIds": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "features": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "build-sluggers",
                  "launch-dolphin",
                  "runtime-bridge",
                  "telemetry-spool",
                  "capture-ffmpeg",
                  "broadcast-rtmp"
                ]
              }
            },
            "dolphinVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "architecture",
            "operatingSystem",
            "runnerVersion",
            "adapterIds",
            "features",
            "dolphinVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "stationName",
        "capabilities"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "runner-registration-response"
        },
        "runnerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 900
        },
        "versionPolicy": {
          "type": "object",
          "properties": {
            "minimumRunnerVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            },
            "recommendedRunnerVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            },
            "status": {
              "type": "string",
              "enum": [
                "current",
                "update-available",
                "update-required"
              ]
            }
          },
          "required": [
            "minimumRunnerVersion",
            "recommendedRunnerVersion",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "runnerId",
        "heartbeatSeconds",
        "leaseSeconds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "runner-heartbeat-request"
        },
        "runnerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
