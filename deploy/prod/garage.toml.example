# Copy this file to an operator-controlled garage.toml and replace every value.
# A real redundant deployment should use at least three Garage nodes and a
# replication factor of three; see README.md before deploying.

metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
metadata_auto_snapshot_interval = "6h"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"
rpc_secret = "replace-with-64-hex-characters-before-starting-garage"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.starworks.example.com"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "replace-before-starting-garage"
metrics_token = "replace-before-starting-garage"
