STARWORKS_HOST=starworks.example.com
TRAEFIK_ACME_EMAIL=operator@example.com
TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

POSTGRES_DB=starworks
POSTGRES_USER=starworks
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://starworks:replace-me@db:5432/starworks

DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://starworks.example.com/auth/discord/callback
SESSION_COOKIE_SECRETS=replace-me-with-at-least-32-random-bytes
METRICS_BEARER_TOKEN=replace-me-with-a-dedicated-random-token

GARAGE_CONFIG_FILE=./garage.toml.example
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=starworks
STARWORKS_BACKUP_DIR=./backups
