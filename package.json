{
  "name": "sluggers-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "npm ci --prefix apps/sluggers-super-draft && npm --prefix experiments/starworks-platform run setup",
    "dev": "npm --prefix apps/sluggers-super-draft run dev",
    "start": "npm --prefix apps/sluggers-super-draft start",
    "build": "npm --prefix apps/sluggers-super-draft run build",
    "typecheck": "npm --prefix apps/sluggers-super-draft run typecheck && npm --prefix experiments/starworks-platform run typecheck",
    "test": "npm --prefix experiments/starworks-platform test",
    "contracts:check": "npm --prefix experiments/starworks-platform run contracts:check",
    "experiment:dev": "npm --prefix experiments/starworks-platform run dev",
    "experiment:test": "npm --prefix experiments/starworks-platform test"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
